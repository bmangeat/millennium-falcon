meta {
  name: Health - liveness
  type: http
  seq: 4
}

get {
  url: {{baseUrl}}/health/live
  body: none
  auth: none
}

vars:pre-request {
  baseUrl: app.millennium-falcon.orb.local
}

assert {
  res.status: eq 200
  res.body.status: eq ok
}

docs {
  The process is up. Used by the Docker HEALTHCHECK.
}
