# Copy to .env for local development (pnpm dev loads it automatically).
NODE_ENV=development
HOST=0.0.0.0
PORT=3000
LOG_LEVEL=debug
# Path to the Millennium Falcon configuration file (JSON).
FALCON_CONFIG_PATH=./config/millennium-falcon.json
# Comma-separated list of allowed CORS origins. Empty = CORS disabled.
CORS_ORIGINS=
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100
